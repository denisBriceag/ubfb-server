# Copy to .env.development (or .env.production) and fill in real values.
# The app loads .env.${NODE_ENV}; real environment variables always take precedence.

NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=ubfb
DB_PASSWORD=ubfb
DB_NAME=ubfb

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# Used in production instead of host/port
REDIS_URL_PROD=

# Auth
JWT_SECRET=change-me
JWT_TOKEN_AUDIENCE=localhost:3000
JWT_TOKEN_ISSUER=localhost:3000
JWT_ACCESS_TOKEN_TTL=600
JWT_REFRESH_TOKEN_TTL=86400
COOKIES_SECRET=change-me

# CORS
ALLOWED_ORIGINS=http://localhost:4200
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
FRONTEND_URL=http://localhost:4200

# Throttling
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Mail (dev default points at the docker-compose mailpit service)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=dev
MAIL_PASS=dev
MAIL_FROM_NAME=UBFB Server
MAIL_FROM_ADDRESS=noreply@ubfb.md

# AWS S3 — the region must be non-empty for the app to boot;
# fill in real credentials to actually use the S3 features
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION=us-east-1
AWS_BUCKET=
AWS_BUCKET_TEMP=
AWS_CLOUDFRONT_URL=

# External APIs
COUNTRIES_API_KEY=
